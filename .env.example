# Copy to .env next to workshop.json for local development only. Never commit .env.
# On servers prefer a root-owned credentials file: WORKSHOP_CREDENTIALS_FILE=/etc/<project>/steam-uploader.env

# Steam account used for uploads (a dedicated uploader account is recommended).
STEAM_USERNAME=

# Optional. Leave empty and run `./workshop login` once so SteamCMD caches a session;
# later runs then need only the username and Steam Guard does not prompt.
STEAM_PASSWORD=

# Optional path to SteamCMD if it is not auto-detected.
STEAMCMD_PATH=

# Directory holding the Windows build of CS2 used for compiling (see `./workshop tools install`).
CS2_TOOLS_DIR=
